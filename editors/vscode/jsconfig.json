{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "checkJs": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "maxNodeModuleJsDepth": 0,
    "types": ["node", "vscode"]
  },
  "include": ["extension.js", "checker.js", "standin/*.js", "lint/*.js", "test/*.js", "test/vscode/*.js", "bench/*.js"]
}
