{
  "name": "cond",
  "version": "1.0.0",
  "exports": {
    ".": {
      "types": {
        "import": "./types/i.d.mts",
        "require": "./types/r.d.cts"
      },
      "default": "./main.js"
    },
    "./custom": {
      "custom": "./custom.js",
      "default": "./default.js"
    },
    "./node": {
      "node": "./node.js",
      "default": "./default.js"
    },
    "./browser": {
      "browser": "./browser.js",
      "default": "./default.js"
    },
    "./order": {
      "default": "./default.js",
      "import": "./i.js"
    },
    "./fallback": {
      "types": "./missing.d.ts",
      "import": "./i.js"
    },
    "./array": [
      "./missing2.js",
      "./i.js"
    ],
    "./nested": {
      "node": {
        "import": {
          "types": "./nested.d.ts"
        }
      }
    },
    "./versioned": {
      "types@>=8": "./v8.d.ts",
      "types@>=5.0": "./v5.d.ts",
      "types": "./v-old.d.ts"
    },
    "./null": null,
    "./null-cond": {
      "import": null,
      "default": "./default.js"
    }
  }
}
